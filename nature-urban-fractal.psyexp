        <Param val="from PIL import Image&amp;#10;stim_dir = &quot;stimuli/images/&quot; + condition&amp;#10;preloaded = {}&amp;#10;for f in os.listdir(stim_dir):&amp;#10;    if f.lower().endswith(('.png', '.jpg', '.jpeg', '.bmp')):&amp;#10;        preloaded[f] = Image.open(os.path.join(stim_dir, f)).convert('RGB')  # decode now&amp;#10;win.clearBuffer()                          # discard the warm-up draws (nothing shown)&amp;#10;&amp;#10;time_recorded = False&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
