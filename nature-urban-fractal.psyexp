        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="import time&amp;#10;&amp;#10;def saveTime(label=&quot;&quot;):&amp;#10;    system_time = time.time()&amp;#10;    # globalClock is the format string ('float') until run() builds the real Clock,&amp;#10;    # so don't call this until Begin Routine&amp;#10;    psychopy_time = globalClock.getTime() # same clock as _ONSET_TIME&amp;#10;    thisExp.addData('sync_system_%s' % label, system_time)&amp;#10;    thisExp.addData('sync_psychopy_%s' % label, psychopy_time)&amp;#10;&amp;#10;    try:&amp;#10;        el_tracker = pylink.getEYELINK()&amp;#10;        el_tracker.sendMessage('SYNC %s SYSTEM %.6f PSYCHOPY %.6f' % (label, system_time, psychopy_time))&amp;#10;    except Exception as e:&amp;#10;        logging.warning('EDF sync message failed (%s): %s' % (label, e))" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="saveTime('session_start')" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="saveTime('end_experiment')" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="timer_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
